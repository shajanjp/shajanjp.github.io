# Cache Control Headers
# Works with Cloudflare Pages. For GitHub Pages, configure via Cloudflare dashboard instead.

# Static assets (CSS, JS, fonts, images)
/assets/**
  Cache-Control: public, max-age=31536000, immutable

# Responsive images generated by eleventy-img
/img/**
  Cache-Control: public, max-age=31536000, immutable

# Blog images (1 month)
/blog/**/*.png
  Cache-Control: public, max-age=2592000, immutable
/blog/**/*.jpg
  Cache-Control: public, max-age=2592000, immutable
/blog/**/*.webp
  Cache-Control: public, max-age=2592000, immutable
/blog/**/*.avif
  Cache-Control: public, max-age=2592000, immutable

# Project images (1 month)
/projects/**/*.png
  Cache-Control: public, max-age=2592000, immutable
/projects/**/*.jpg
  Cache-Control: public, max-age=2592000, immutable
/projects/**/*.webp
  Cache-Control: public, max-age=2592000, immutable
/projects/**/*.svg
  Cache-Control: public, max-age=2592000, immutable

# Photography images (1 year)
/photography/**/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/photography/**/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Shortcuts images (6 months)
/shortcuts/**/*.png
  Cache-Control: public, max-age=15724800, immutable
/shortcuts/**/*.webp
  Cache-Control: public, max-age=15724800, immutable
